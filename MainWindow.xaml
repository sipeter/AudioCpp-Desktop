<Window x:Class="AudioCppDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioCpp Desktop"
        Icon="Assets/app.ico"
        Height="740" Width="1060"
        MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAppTitle" Text="AudioCpp 桌面端" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVersionBadge" Text="v0.1.0" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontFamily="Consolas"/>
                        </Border>
                        <Border x:Name="StatusBadge" Background="#FEE2E2" CornerRadius="10" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="已停止" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentRed}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LblRootDir" Text="运行目录：" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RootPathText" Text="" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                        <Button x:Name="BtnBrowseRoot" Content="选择目录..." Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="8,0,0,0" FontSize="12" Click="BrowseRoot_Click"/>
                        <Button x:Name="BtnRefreshHeader" Content="刷新" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="6,0,0,0" FontSize="12" Click="RefreshAll_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStart" Content="▶ 启动服务" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="StartServer_Click"/>
                    <Button x:Name="BtnStop" Content="■ 停止服务" Style="{StaticResource DangerButton}" Margin="0,0,8,0" IsEnabled="False" Click="StopServer_Click"/>
                    <Button x:Name="BtnOpenWebUi" Content="打开网页控制台" Style="{StaticResource SecondaryButton}" Click="OpenWebUi_Click"/>
                    <Border Width="1" Height="22" Background="{StaticResource BorderSubtle}" Margin="12,0,12,0"/>
                    <ComboBox x:Name="CmbLanguage" Width="100" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectionChanged="Language_SelectionChanged"/>
                    <Button x:Name="BtnHeaderGitHub" Style="{StaticResource IconButton}"
                            ToolTip="GitHub: https://github.com/sipeter/AudioCpp-Desktop"
                            Tag="https://github.com/sipeter/AudioCpp-Desktop" Click="OpenExternalLink_Click">
                        <Path Width="17" Height="17" Stretch="Uniform" Fill="#334155"
                              Data="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- Tab 1: Server & Connection -->
            <TabItem x:Name="TabServer" Header="  服务与手机连接  " FontSize="13.5" Padding="12,6">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Settings + Phone Connect -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Server Settings Card -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="LblServerSettings" Text="服务运行参数" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="LblBackend" Grid.Row="0" Grid.Column="0" Text="推理后端：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="CmbBackend" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" SelectionChanged="SettingsInput_Changed">
                                        <ComboBoxItem x:Name="CbiCuda" Content="CUDA 显卡加速（推荐）" Tag="cuda"/>
                                        <ComboBoxItem x:Name="CbiCpu" Content="CPU 兼容模式" Tag="cpu"/>
                                    </ComboBox>

                                    <TextBlock x:Name="LblPort" Grid.Row="1" Grid.Column="0" Text="监听端口：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="TxtPort" Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" Text="18080" LostFocus="SettingsInput_LostFocus"/>

                                    <TextBlock x:Name="LblMaxModels" Grid.Row="2" Grid.Column="0" Text="最大常驻模型：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="TxtMaxModels" Width="60" Height="28" VerticalContentAlignment="Center" Padding="6,0" Text="1" LostFocus="SettingsInput_LostFocus"/>
                                        <TextBlock x:Name="LblMaxModelsHint" Text="（建议 1，切换大模型自动释放显存）" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <CheckBox x:Name="ChkMinimizeToTray" Grid.Row="3" Grid.ColumnSpan="2" Content="关闭窗口时最小化到系统托盘（服务继续在后台运行）"
                                              IsChecked="True" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" Click="SettingsInput_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Phone Connection Card -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="LblPhoneConnect" Text="CloneTTS 手机端接入信息（OpenAI 兼容模式）" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblLanUrl" Grid.Column="0" Text="局域网地址：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="TxtLanUrl" Grid.Column="1" IsReadOnly="True" Height="28" VerticalContentAlignment="Center" Padding="8,0" Background="#F8FAFC" FontFamily="Consolas"/>
                                    <Button x:Name="BtnCopyLanUrl" Grid.Column="2" Content="复制地址" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0" Click="CopyLanUrl_Click"/>
                                </Grid>

                                <TextBlock x:Name="LblModelChipsHint" Text="已识别模型 ID（点击任意标签可直接复制填入手机端「模型」栏）：" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,6"/>
                                <ItemsControl x:Name="InstalledModelChips">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Id}" Tag="{Binding Id}" Style="{StaticResource SecondaryButton}"
                                                    Padding="10,4" Margin="0,0,6,6" FontFamily="Consolas" FontSize="12"
                                                    ToolTip="{Binding FileName}" Click="CopyModelId_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoModelsHint" Text="当前 models 目录为空，请先切到「模型管理」下载至少一个 GGUF 模型。"
                                           FontSize="12" Foreground="{StaticResource AccentAmber}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 1: Quick Local Synthesis Test -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblTestModel" Grid.Column="0" Text="快捷试听  模型：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbTestModel" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="LblTestVoice" Grid.Column="2" Text="音色：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbTestVoice" Grid.Column="3" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtTestInput" Grid.Column="4" Height="28" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0"
                                     Text="你好，欢迎使用 CloneTTS 电脑端音频合成服务。"/>
                            <Button x:Name="BtnTestSpeak" Grid.Column="5" Content="🔊 合成试听" Style="{StaticResource PrimaryButton}" Padding="14,5" Click="TestSpeak_Click"/>
                        </Grid>
                    </Border>

                    <!-- Row 2: Live Logs -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock x:Name="LblLiveLogs" Text="实时服务日志" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <Button x:Name="BtnClearLogs" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="清空日志" Style="{StaticResource SecondaryButton}" Padding="10,3" FontSize="12" Click="ClearLogs_Click"/>
                            </DockPanel>
                            <TextBox x:Name="TxtLogs" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="#0F172A" Foreground="#E2E8F0" BorderThickness="0" Padding="10"
                                     FontFamily="Consolas" FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Model Manager -->
            <TabItem x:Name="TabModels" Header="  模型管理与下载  " FontSize="13.5" Padding="12,6">
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LblDlSource" Text="下载源：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbDownloadSource" Width="250" Height="30" VerticalContentAlignment="Center" SelectionChanged="SettingsInput_Changed">
                                    <ComboBoxItem x:Name="CbiMs" Content="魔搭 ModelScope 国内镜像（推荐）" Tag="modelscope"/>
                                    <ComboBoxItem x:Name="CbiHf" Content="HuggingFace 官方源（海外直连）" Tag="huggingface"/>
                                </ComboBox>
                                <TextBlock x:Name="ModelsDirText" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnBrowseModelsDir" Content="更换模型目录..." Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BrowseModelsDir_Click"/>
                                <Button x:Name="BtnOpenModelsDir" Content="打开目录" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="OpenModelsDir_Click"/>
                                <Button x:Name="BtnRefreshModels" Content="刷新" Style="{StaticResource SecondaryButton}" Click="RefreshAll_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid x:Name="ModelsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeight="46" AlternatingRowBackground="#F8FAFC" BorderBrush="{StaticResource BorderSubtle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColModelName" Header="模型名称" Binding="{Binding DisplayName}" Width="165"/>
                                <DataGridTextColumn x:Name="ColModelId" Header="模型 ID" Binding="{Binding ModelId}" Width="105"/>
                                <DataGridTextColumn x:Name="ColModelSize" Header="大小" Binding="{Binding SizeLabel}" Width="75"/>
                                <DataGridTextColumn x:Name="ColModelPromptReq" Header="参考文本要求" Binding="{Binding PromptTextRequirement}" Width="115"/>
                                <DataGridTextColumn x:Name="ColModelDesc" Header="特点说明" Binding="{Binding Description}" Width="*"/>
                                <DataGridTemplateColumn x:Name="ColModelStatus" Header="状态 / 进度" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="4,0">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" Height="6" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ColModelAction" Header="操作" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding ActionLabel}" Tag="{Binding}" Padding="8,4" Margin="4"
                                                    Style="{StaticResource SecondaryButton}" Click="ModelAction_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 3: Voice Library -->
            <TabItem x:Name="TabVoices" Header="  参考音色库 (voice-library)  " FontSize="13.5" Padding="12,6">
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnImportVoice" Content="+ 导入参考音频 (.wav / .mp3 / .m4a)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="ImportVoice_Click"/>
                                <Button x:Name="BtnSavePrompts" Content="💾 保存全部参考文本" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SavePrompts_Click"/>
                                <TextBlock x:Name="LblAsrModel" Text="ASR:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="4,0,4,0"/>
                                <ComboBox x:Name="CmbAsrModel" Width="125" Height="28" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                                <Button x:Name="BtnTranscribeEmpty" Content="✨ 识别空白文本" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="TranscribeEmpty_Click"/>
                                <Button x:Name="BtnBrowseVoiceDir" Content="更换音色目录..." Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BrowseVoiceDir_Click"/>
                                <Button x:Name="BtnOpenVoiceDir" Content="打开目录" Style="{StaticResource SecondaryButton}" Click="OpenVoiceDir_Click"/>
                            </StackPanel>
                            <Button x:Name="BtnRefreshVoices" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="刷新音色" Style="{StaticResource SecondaryButton}" Click="RefreshAll_Click"/>
                        </DockPanel>

                        <TextBlock x:Name="VoiceDirHintText" Grid.Row="1" Margin="0,0,0,10" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Text=""/>

                        <DataGrid x:Name="VoicesGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeight="40" AlternatingRowBackground="#F8FAFC" BorderBrush="{StaticResource BorderSubtle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColVoiceName" Header="音色名 (文件名)" Binding="{Binding Name}" IsReadOnly="True" Width="170"/>
                                <DataGridTextColumn x:Name="ColVoiceSize" Header="大小" Binding="{Binding SizeText}" IsReadOnly="True" Width="85"/>
                                <DataGridTextColumn x:Name="ColVoicePrompt" Header="参考音频逐字文本 (prompt_text，双击编辑)" Binding="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTemplateColumn x:Name="ColVoiceAsr" Header="识别" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="ASR" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="4" Click="TranscribeSingleVoice_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ColVoicePlay" Header="试听" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="▶" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="4" Click="PlayVoiceRef_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 4: About -->
            <TabItem x:Name="TabAbout" Header="  关于  " FontSize="13.5" Padding="12,6">
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="24,22">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                            <!-- Hero Brand Section -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="Assets/app_icon.png" Width="64" Height="64" Margin="0,2,18,0"
                                       VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutTitle" Text="AudioCpp Desktop" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="AboutVersionBadge" Text="v0.1.0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontFamily="Consolas"/>
                                        </Border>
                                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Apache-2.0" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" FontFamily="Consolas"/>
                                        </Border>
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="audio.cpp v0.9.6" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="AboutDesc" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondary}" LineHeight="21" Margin="0,8,0,0" Text=""/>
                                </StackPanel>
                            </Grid>

                            <!-- 2x2 Link Cards -->
                            <TextBlock x:Name="AboutLinksHeader" Text="相关项目与模型镜像" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2" Margin="0,0,0,18">
                                <Button Style="{StaticResource LinkCardButton}" Margin="0,0,10,10"
                                        Tag="https://github.com/sipeter/AudioCpp-Desktop" Click="OpenExternalLink_Click">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="↗" FontSize="15" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock x:Name="LblCardSelf" Text="AudioCpp-Desktop 开源主页" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="github.com/sipeter/AudioCpp-Desktop" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Button Style="{StaticResource LinkCardButton}" Margin="0,0,0,10"
                                        Tag="https://github.com/0xShug0/audio.cpp" Click="OpenExternalLink_Click">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="↗" FontSize="15" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock x:Name="LblCardEngine" Text="audio.cpp 上游推理引擎" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="github.com/0xShug0/audio.cpp" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Button Style="{StaticResource LinkCardButton}" Margin="0,0,10,0"
                                        Tag="https://huggingface.co/audio-cpp/audio.cpp-gguf" Click="OpenExternalLink_Click">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="↗" FontSize="15" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
